# ---------------------------------------------------------------------------
# BatiKa — production environment template (Vercel)
# ---------------------------------------------------------------------------
# Do NOT commit this file with real values. It documents every variable the
# application expects in production. Add the real values in the Vercel
# dashboard (Project → Settings → Environment Variables) or with `vercel env`.
# ---------------------------------------------------------------------------

APP_NAME=BatiKa
APP_ENV=production
APP_KEY=base64:GENERATE_A_RANDOM_32_BYTE_KEY
APP_DEBUG=false
APP_URL=https://your-project.vercel.app
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database (MySQL). Recommended free option: Aiven for MySQL.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=your-mysql-host
DB_PORT=12345
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your-password

# Base64 encoded CA certificate (required by most managed MySQL providers).
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("ca.pem"))
# macOS/Linux: base64 -i ca.pem | tr -d '\n'
DB_SSL_CA_BASE64=

# ---------------------------------------------------------------------------
# Session, cache and queue
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=sync

# ---------------------------------------------------------------------------
# Firebase Storage (product images, avatars, review photos)
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=public
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# Base64 encoded service account JSON (Firebase → Project settings →
# Service accounts → Generate new private key).
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json")) | Set-Clipboard
FIREBASE_CREDENTIALS_BASE64=

# ---------------------------------------------------------------------------
# Mail (required: registration uses OTP codes sent by email)
# Example uses Brevo; Resend, Mailgun, Gmail SMTP also work.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Midtrans payment gateway
# ---------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# ---------------------------------------------------------------------------
# Seed credentials (use ONLY while running the seeder, then remove them)
# ---------------------------------------------------------------------------
SEED_OWNER_EMAIL=owner@your-domain.com
SEED_OWNER_NAME=Owner BatiKa
SEED_OWNER_PASSWORD=change-this-password
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_NAME=Admin BatiKa
SEED_ADMIN_PASSWORD=change-this-password
